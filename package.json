{
  "name": "leoliao-app",
  "version": "0.1.0",
  "description": "知识库 Android APP",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:run": "cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capawesome/capacitor-file-picker": "^6.2.0",
    "dexie": "^4.0.10",
    "dompurify": "^3.4.11",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lit": "^3.2.1",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/markdown-it": "^14.1.2",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
