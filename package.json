                         "@capacitor/share":  "^6.0.4",
                         "@capawesome/capacitor-file-picker":  "^6.2.0",
                         "@xenova/transformers":  "^2.17.2",
                         "dexie":  "^4.0.10",
                         "dompurify":  "^3.4.11",
                         "gray-matter":  "^4.0.3",
                         "html2canvas":  "^1.4.1",
                         "jspdf":  "^4.2.1",
                         "jszip":  "^3.10.1",
                         "lit":  "^3.2.1",
                         "mammoth":  "^1.12.0",
                         "markdown-it":  "^14.1.0",
                         "pdfjs-dist":  "^6.3.289"
                     },
    "devDependencies":  {
                            "@capacitor/cli":  "^6.1.2",
